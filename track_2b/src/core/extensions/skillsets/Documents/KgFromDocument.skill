{
  "Id": "KgFromDocument",
  "Name": "KG from Document",
  "Role": 2,
  "Description": "Extracts a Knowledge Graph (KG) from a document according to a given ontology. The ontology defines entity types (:EntityOntology nodes) and relationship types (:RelationshipOntology nodes) with their attributes. The skill processes the document's full enhanced text in one pass:\n 1. For each entity type in the ontology, an LLM call identifies all instances in the document; then for each entity attribute, a further LLM call extracts the attribute value for every discovered instance.\n 2. For each relationship type in the ontology, an LLM call identifies relationship instances between the already-extracted entities; then for each relationship attribute, a further LLM call extracts the attribute value.\n All results are persisted to Neo4j as :Entity nodes with their attributes and relationships.\n\nCall this skill after ensuring the target ontology exists (use an Ontology editor skill if needed). The skill auto-creates a Community to hold the extracted entities if none is provided.",
  "IsInteractive": false,
  "Args": {
    "ontology_id": {
      "Name": "ontology_id",
      "Type": "string",
      "Description": "Identifier of the ontology to use for KG construction. The ontology must define :EntityOntology and/or :RelationshipOntology nodes. Example: 'MY_ONTOLOGY_ID'.",
      "Required": true,
      "Value": ""
    },
    "document_id": {
      "Name": "document_id",
      "Type": "string",
      "Description": "Identifier of the document from which the KG will be extracted. The document's enhanced_text (or fallback text) is used. Example: 'docid-42'.",
      "Required": true,
      "Value": ""
    },
    "community_id": {
      "Name": "community_id",
      "Type": "string",
      "Description": "Optional identifier of the community (entity group) in which the extracted :Entity nodes are stored. If omitted, a community is auto-generated by combining the ontology_id and document_id. Example: 'my_community'.",
      "Required": false,
      "Value": ""
    }
  },
  "ArgsHtml": null,
  "Result": {
    "success": {
      "Name": "success",
      "Type": "boolean",
      "Description": "True if the extraction completed without fatal errors.",
      "Required": true,
      "Value": ""
    },
    "community_id": {
      "Name": "community_id",
      "Type": "string",
      "Description": "The community_id under which all extracted entities were stored.",
      "Required": false,
      "Value": ""
    },
    "entities_count": {
      "Name": "entities_count",
      "Type": "integer",
      "Description": "Total number of :Entity nodes created or updated.",
      "Required": false,
      "Value": ""
    },
    "entities": {
      "Name": "entities",
      "Type": "list",
      "Description": "List of extracted entity summaries: [{id, label, name}].",
      "Required": false,
      "Value": ""
    },
    "error": {
      "Name": "error",
      "Type": "integer",
      "Description": "Error code when the skill fails. 1 = user / input error.",
      "Required": false,
      "Value": ""
    },
    "error_message": {
      "Name": "error_message",
      "Type": "string",
      "Description": "Human-readable error description when the skill fails.",
      "Required": false,
      "Value": ""
    }
  },
  "ResultHtml": null,
  "API_Keys": null,
  "Dependencies": [],
  "CSharpClass": null,
  "BlackList_IF": null,
  "LLM_Label": null,
  "utilize_llm": true,
  "error": null,
  "error_message": null
}