    <thalabus:attrName>party</thalabus:attrName>
    <thalabus:attrType>string</thalabus:attrType>
    <thalabus:attrValue>Harmonized party acronym (source party_harmonized; 61.5% fill on contributors, 89.6% on votes). Soft link to Organisation nodes of kind party.</thalabus:attrValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/KeywordCategory/keyword_cat_6958f5cbe3fc">
