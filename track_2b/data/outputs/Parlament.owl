    <thalabus:attrValue>JSON object of per-language preferred labels, e.g. {"de": "...", "fr": "...", "it": "..."}, plus the translated rm label (T10 F5/R3).</thalabus:attrValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/RelationshipOntology/Parlament/CONTRIBUTES_TO">
