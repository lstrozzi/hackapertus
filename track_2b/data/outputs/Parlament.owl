    <thalabus:entityId>keyword_cat_a3e9324d69ba</thalabus:entityId>
    <rdfs:label>ANSWER_TYPE</rdfs:label>
    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <rdfs:comment>Categorizes the document based on the nature of the response (e.g., official government answer to a parliamentary inquiry, policy statement, factual report).</rdfs:comment>
    <thalabus:lov>OFFICIAL_GOVERNMENT_RESPONSE, POLICY_STATEMENT, FACTUAL_REPORT</thalabus:lov>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/OntologyAttribute/Parlament/Canton/canton_code">
