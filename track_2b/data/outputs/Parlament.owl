    <rdfs:comment>Documents specifically addressing tax treatment of business succession, transfer of ownership, and related financial consequences for the seller and buyer.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/KeywordCategory/keyword_cat_efb9308d3fea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <thalabus:nodeType>KeywordCategory</thalabus:nodeType>
    <thalabus:entityId>keyword_cat_efb9308d3fea</thalabus:entityId>
