  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/KeywordCategory/keyword_cat_3c407f324ef9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <thalabus:nodeType>KeywordCategory</thalabus:nodeType>
    <thalabus:entityId>keyword_cat_3c407f324ef9</thalabus:entityId>
    <rdfs:label>VOCATIONAL_TRAINING_SUPPORT</rdfs:label>
    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <rdfs:comment>Documents proposing or discussing financial, fiscal, or regulatory support for companies offering apprenticeships</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/RelationshipOntology/Parlament/PUBLISHED_BY">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>PUBLISHED_BY</rdfs:label>
    <thalabus:nodeType>RelationshipOntology</thalabus:nodeType>
    <thalabus:entityId>955e3bb0-9361-4d09-96a8-21d97322e738</thalabus:entityId>
