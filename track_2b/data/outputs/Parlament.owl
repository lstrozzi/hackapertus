    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <thalabus:attrName>eurovoc_uri</thalabus:attrName>
    <thalabus:attrType>string</thalabus:attrType>
    <thalabus:attrValue>Optional alignment URI to a EuroVoc concept. Kept separate from topic_uri so alignment stays revisable; exact prefLabel matching is not reliable (T10 F4).</thalabus:attrValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/OntologyAttribute/Parlament/Person/party">
