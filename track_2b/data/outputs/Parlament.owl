    <thalabus:parentId>1133b3a5-c3a8-4b44-b33e-48e05fcb0ae1</thalabus:parentId>
    <thalabus:parentLabel>Organisation</thalabus:parentLabel>
    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <thalabus:attrName>official_key</thalabus:attrName>
    <thalabus:attrType>string</thalabus:attrType>
    <thalabus:attrValue>Corpus body or party key. Stable re-link key.</thalabus:attrValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/OntologyAttribute/Parlament/Topic/eurovoc_uri">
