    <thalabus:attrValue>Two-letter canton key (bodies.canton_key), e.g. BE, SH, GR. Canonical join key; persons and votes reference cantons by the same two-letter codes.</thalabus:attrValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/KeywordCategory/keyword_cat_bdf63e479a69">
