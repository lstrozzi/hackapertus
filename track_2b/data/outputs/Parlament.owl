    <thalabus:attrType>string</thalabus:attrType>
    <thalabus:attrValue>OpenParlData body id of the canton parliament (bodies.id where type=canton). Join key to the Organisation node for the legislature and to Affair.scope. Measured 26 canton bodies.</thalabus:attrValue>
  </rdf:Description>
