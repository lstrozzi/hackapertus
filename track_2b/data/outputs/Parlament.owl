    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <thalabus:attrName>since</thalabus:attrName>
    <thalabus:attrType>string</thalabus:attrType>
    <thalabus:attrValue>Optional. Year or date since which the person is a member of the organisation.</thalabus:attrValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/KeywordCategory/keyword_cat_6dd76090952d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <thalabus:nodeType>KeywordCategory</thalabus:nodeType>
    <thalabus:entityId>keyword_cat_6dd76090952d</thalabus:entityId>
    <rdfs:label>CORPORATE_INHERITANCE_TAX</rdfs:label>
