    <thalabus:typeLabel>CONTRIBUTES_TO</thalabus:typeLabel>
    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <rdfs:comment>A person contributed to an affair. One relationship type for all contributor roles: role_kind carries the distinction (the enum supersedes 67% of contributor rows and keeps the ontology lighter than per-role types, T13 D2).</rdfs:comment>
    <thalabus:sourceLabels>Person</thalabus:sourceLabels>
    <thalabus:targetLabels>Affair</thalabus:targetLabels>
