  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/KeywordCategory/keyword_cat_7ac824d5d1bd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <thalabus:nodeType>KeywordCategory</thalabus:nodeType>
    <thalabus:entityId>keyword_cat_7ac824d5d1bd</thalabus:entityId>
    <rdfs:label>INCLUSIVE_EDUCATION</rdfs:label>
    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <rdfs:comment>Documents that focus on policies, practices, or discussions related to integrating students with diverse learning needs into mainstream educational settings.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/OntologyAttribute/Parlament/Topic/topic_uri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <thalabus:nodeType>OntologyAttribute</thalabus:nodeType>
    <thalabus:parentId>03b83a60-becb-4e4e-af82-ca657a17de0c</thalabus:parentId>
    <thalabus:parentLabel>Topic</thalabus:parentLabel>
    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <thalabus:attrName>topic_uri</thalabus:attrName>
    <thalabus:attrType>string</thalabus:attrType>
    <thalabus:attrValue>Solution-owned topic URI: stable identifier minted by the T10 derived scheme (hybrid: derived seeds plus EuroVoc URIs only where an aligned concept exists; scheme=derived).</thalabus:attrValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/RelationshipOntology/Parlament/ABOUT_TOPIC">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>ABOUT_TOPIC</rdfs:label>
    <thalabus:nodeType>RelationshipOntology</thalabus:nodeType>
    <thalabus:entityId>06198916-519a-4150-b787-d9ec8e6628d9</thalabus:entityId>
    <thalabus:typeLabel>ABOUT_TOPIC</thalabus:typeLabel>
    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <rdfs:comment>An affair is about this subject topic (T13 D2, T10 derived scheme; classifier output, Tier 1 edge pointing at the Tier-2 Topic entity). The weight carries the classifier confidence rather than a binary judgement, so downstream filtering can threshold. Under the category-first option (C-1) this same signal rides the TOPIC document category instead and costs no edge type.</rdfs:comment>
    <thalabus:sourceLabels>Affair</thalabus:sourceLabels>
    <thalabus:targetLabels>Topic</thalabus:targetLabels>
    <thalabus:hasAttribute rdf:resource="https://thalabus.io/ontology/OntologyAttribute/Parlament/ABOUT_TOPIC/weight"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/OntologyAttribute/Parlament/Affair/extraction_notes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <thalabus:nodeType>OntologyAttribute</thalabus:nodeType>
    <thalabus:parentId>3aeb81a6-e243-420a-a936-cf5de4c6da5c</thalabus:parentId>
    <thalabus:parentLabel>Affair</thalabus:parentLabel>
    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <thalabus:attrName>extraction_notes</thalabus:attrName>
    <thalabus:attrType>string</thalabus:attrType>
    <thalabus:attrValue>Free-text classifier rationale recorded during ingestion/harmonization.</thalabus:attrValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/KeywordCategory/keyword_cat_a0df8d2966c0">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <thalabus:nodeType>KeywordCategory</thalabus:nodeType>
    <thalabus:entityId>keyword_cat_a0df8d2966c0</thalabus:entityId>
    <rdfs:label>TEACHER_TRAINING</rdfs:label>
    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <rdfs:comment>Documents that address the preparation, curriculum, or professional development of teachers, particularly concerning new educational challenges or methodologies.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/KeywordCategory/keyword_cat_6b87a33128b5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <thalabus:nodeType>KeywordCategory</thalabus:nodeType>
    <thalabus:entityId>keyword_cat_6b87a33128b5</thalabus:entityId>
