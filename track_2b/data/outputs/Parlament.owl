    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <thalabus:attrName>submitted_on</thalabus:attrName>
    <thalabus:attrType>date</thalabus:attrType>
    <thalabus:attrValue>Date on which the affair was submitted.</thalabus:attrValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/OntologyAttribute/Parlament/Organisation/org_kind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <thalabus:nodeType>OntologyAttribute</thalabus:nodeType>
    <thalabus:parentId>1133b3a5-c3a8-4b44-b33e-48e05fcb0ae1</thalabus:parentId>
    <thalabus:parentLabel>Organisation</thalabus:parentLabel>
    <thalabus:ontologyId>Parlament</thalabus:ontologyId>
    <thalabus:attrName>org_kind</thalabus:attrName>
