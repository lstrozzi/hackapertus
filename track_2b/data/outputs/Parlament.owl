    <thalabus:sourceLabels>Affair</thalabus:sourceLabels>
    <thalabus:targetLabels>Organisation</thalabus:targetLabels>
  </rdf:Description>
  <rdf:Description rdf:about="https://thalabus.io/ontology/OntologyAttribute/Parlament/Affair/source_url">
