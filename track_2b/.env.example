# Copy to .env and fill in. .env carries SECRETS ONLY. Every other setting (endpoints,
# model names, addresses, ports, plans) is a literal in docker-compose.yml,
# docker-compose.plan-saas.yml or docker-compose.plan-local.yml, so no shell variable
# or stray line can silently redirect a service. Nothing here is needed to build.
# Compose reads this file once, at container creation, so changing a secret takes
# `make run` (which recreates the container), never `docker restart`.
# Never commit a real .env — it is gitignored by design and excluded from distribution.

# ── Secrets ─────────────────────────────────────────────────────────────────────

# Chat endpoint bearer token (T2B LLM Lite key). One token covers chat, embeddings and
# rerank once the provider enables those routes, so the retrieval keys default to it;
# the two lines below only matter when the provider issues separate keys.
LLM_API_KEY=replace-with-your-LLM-Lite-key
# EMBEDDINGS_API_KEY=
# RERANKER_API_KEY=

# Graph database password. Doubles as the local `graph` container's own auth, so one
# value keeps the container and the app's login in step. The SaaS laptop profile
# connects to a database published on the host instead — set this to that database's
# password there.
NEO4J_PASSWORD=hackathon-2026

# ── Run plan ────────────────────────────────────────────────────────────────────
# The plan is not a .env setting: loading docker-compose.plan-local.yml or
# docker-compose.plan-saas.yml IS the choice (`make run` vs `make run PLAN=SaaS`), and
# each file declares its plan as a literal. The endpoints, ports and image names those
# screens read live in the same YAML files — see docs/RUN_PLANS.md.

# Optional platform secrets:

# GLOBAL platform token — a platfadmin token (user type "platform"), NOT a session
# token. Only the SaaS Model Configuration card uses it: it signs the POST to
# /v1/api/platform/config/model with this value; a session token authenticates but
# always returns 403 (T26 C1). Instance access is a run precondition obtained by
# agreement with the platform owner, not part of this submission — see PROVENANCE.md.
# THALABUS_TOKEN=

# Optional replacement key for the platform's model entry (same card). A blank or
# absent key makes the platform keep the key it already has; keys are write-only, so
# only tokenConfigured in the POST reply confirms it. All other card values are now
# literals in docker-compose.plan-saas.yml, mirroring the platform's own DEFAULT model
# entry, so the read-only card shows exactly what Save will apply.
# SAAS_CFG_KEY=

# ── Not secrets ─────────────────────────────────────────────────────────────────
# The Docker Engine address pair, retrieval routes, model names, the graph URI, the
# platform images and all ports are literals in the compose files. The port published
# for the GUI above is the one exception kept as a file entry: scripts/verify_submission.py
# derives its --live base URL from the PORT line below, and the Makefile reads it too.
PORT=8000